# HealthForge — Production Caddyfile (parallel to dwight, ports 8080/8443)
{
    email admin@endgear.de
}

# ============ API ============
http://api.healthforge.endgear.de {
    reverse_proxy api:8080 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    request_body {
        max_size 100MB
    }

    encode gzip zstd
}

# ============ Admin UI ============
http://admin.healthforge.endgear.de {
    root * /srv/admin
    try_files {path} /index.html
    file_server

    encode gzip zstd
}

# ============ CDN (public MinIO bucket) ============
http://cdn.healthforge.endgear.de {
    reverse_proxy minio:9000 {
        header_up Host {upstream_hostport}
    }

    encode gzip
}

# CI-Trigger 2026-06-07 - server-ci deploy test
